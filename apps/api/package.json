{
  "name": "@eventops/api",
  "version": "0.1.0",
  "private": true,
  "description": "EventOps Express Backend - Modular Monolith",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
