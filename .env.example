# Application
NODE_ENV=development
PORT=4000
WEB_PORT=3000
VITE_API_URL=http://localhost:4000/api

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventops
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventops?schema=public

# Redis & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=eventops_super_secret_jwt_access_token_key_change_in_prod_2026
JWT_REFRESH_SECRET=eventops_super_secret_jwt_refresh_token_key_change_in_prod_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 Object Storage (MinIO locally)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eventops
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Email & Background Delivery (Mailhog locally)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EventOps <no-reply@eventops.local>

# Ticket / Certificate signing
TICKET_SIGNING_SECRET=eventops_ticket_hmac_secret_2026
