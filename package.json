{
  "name": "eventops",
  "version": "0.1.0",
  "private": true,
  "description": "EventOps — Community & Event Collaboration Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate --workspace=@eventops/api",
    "prisma:generate": "npm run prisma:generate --workspace=@eventops/api",
    "build:types": "npm run build --workspace=@eventops/shared-types",
    "build:api": "npm run build --workspace=@eventops/api",
    "build:web": "npm run build --workspace=@eventops/web",
    "build": "npm run build:types && npm run build:api && npm run build:web",
    "dev:api": "npm run dev --workspace=@eventops/api",
    "dev:web": "npm run dev --workspace=@eventops/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
